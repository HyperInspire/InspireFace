<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:minHeight="184dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:background="@drawable/bg_home_icon"
            android:backgroundTint="@color/home_tile_silent_plus"
            android:padding="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_home_silent_plus" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_plus_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="24dp"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="@string/menu_badge_plus"
            android:textColor="@color/home_plus_badge_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_silent_plus_title"
        android:textColor="@color/home_tile_text_dark"
        android:textSize="17sp"
        android:maxLines="2"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="3"
        android:text="@string/home_silent_plus_desc"
        android:textColor="@color/home_tile_text_dark_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="1dp" />
</LinearLayout>
