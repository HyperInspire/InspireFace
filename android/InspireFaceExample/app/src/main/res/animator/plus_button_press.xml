<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:valueType="floatType" android:duration="90" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.985" android:valueType="floatType" android:duration="90" />
        </set>
    </item>
    <item>
        <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="180" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>
</selector>
