<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plusRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/plus_background"
    android:paddingHorizontal="24dp" android:paddingTop="12dp" android:paddingBottom="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.15" android:orientation="vertical" android:layout_marginEnd="28dp">
        <include layout="@layout/view_plus_header" />
        <FrameLayout android:id="@+id/plusPreviewCard"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.camera.view.PreviewView android:id="@+id/plusPreview"
                android:layout_width="match_parent" android:layout_height="match_parent"
                app:implementationMode="compatible" app:scaleType="fillCenter" />
            <com.example.inspireface_example.view.PlusFaceGuideView android:id="@+id/plusGuide"
                android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <com.example.inspireface_example.view.AnimatedLabelView android:id="@+id/plusGuideHint"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:gravity="center" android:text="@string/plus_align" android:textColor="@color/plus_text_secondary"
            android:textSize="13sp" android:maxLines="2" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="vertical" android:paddingVertical="8dp">
            <include layout="@layout/view_plus_controls" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
